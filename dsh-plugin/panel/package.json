{
  "name": "@mlt_123/dsh-openfuyao-panel-test",
  "version": "0.1.0",
  "description": "Right-sidebar openFuyao panel for DeepSeek Harness, rendered through dsh-better-sidebar.",
  "type": "module",
  "license": "MIT",
  "icon": "icon.svg",
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwitty/witty-service.git",
    "directory": "dsh-plugin/panel"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ]
}
